{
  "name": "s3-upload-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-to-S3 multipart uploads for very large files, with async processing on SQS + Lambda.",
  "license": "MIT",
  "author": "Kevin Makwana",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "functions",
    "infra"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "smoke:aws": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects smoke --runInBand",
    "build": "npm run build --workspaces --if-present",
    "synth": "npm run synth -w infra",
    "localstack:up": "docker compose up -d --wait localstack",
    "localstack:down": "docker compose down -v",
    "localstack:deploy": "npm run deploy:local -w infra",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @s3up/api\" \"npm run dev -w @s3up/web\"",
    "gen:file": "tsx scripts/gen-file.ts",
    "soak": "tsx scripts/soak.ts",
    "synth:api": "npm run synth:api -w infra",
    "synth:full": "npm run synth:full -w infra",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "prepare": "husky || true",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1153.0",
    "@aws-sdk/client-sqs": "^3.1153.0",
    "@aws-sdk/client-sts": "^3.1153.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jimp": "^1.6.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
