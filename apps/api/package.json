{
  "name": "@s3up/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API that issues presigned multipart-upload URLs and reports file status. It never touches file bytes.",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.js --sourcemap --external:@nestjs/microservices --external:@nestjs/websockets --external:class-validator --external:class-transformer --external:@nestjs/platform-fastify",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@s3up/core": "*",
    "@s3up/data": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
