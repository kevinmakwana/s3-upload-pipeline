# Copy to .env.local (or let `npm run localstack:deploy` generate it) to run the API against LocalStack.
BUCKET_NAME=s3up-uploads-000000000000-us-east-1
TABLE_NAME=replace-with-the-FilesTable-name-from-the-stack-outputs
AWS_ENDPOINT_URL=http://localhost:4566
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Optional tuning
# PART_SIZE_BYTES=67108864          # preferred part size (grows automatically to stay under 10,000 parts)
# MAX_FILE_SIZE_BYTES=21474836480   # 20 GiB
# PRESIGN_EXPIRES_SECONDS=900       # clamped to 60..3600
# S3_PUBLIC_ENDPOINT=               # only if the browser reaches S3 at a different URL than the API does

# Authentication. The default (header) trusts x-user-id and is for this local demo only: with
# NODE_ENV=production the API refuses to start in that mode.
# AUTH_MODE=jwt
# JWT_ISSUER=https://your-tenant.auth0.com/
# JWT_AUDIENCE=https://upload-api.example.com
# JWT_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json

# Set to true only when the deployed stack scans uploads (-c malwareScan=true): downloads then wait for a clean verdict.
# MALWARE_SCAN=true
